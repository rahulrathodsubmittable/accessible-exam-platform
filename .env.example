# ---------------------------------------------------------------------------
# Browser-safe (bundled into the frontend). Used only by the Teacher portal.
# Supabase dashboard → Project Settings → API.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# ---------------------------------------------------------------------------
# Server-only (used by the /api functions). NEVER prefix these with VITE_.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: enables AI explanations, paper improvement, OCR and AI summaries.
# Without it the app still works and falls back to stored explanations.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   (any OpenAI-compatible endpoint)
